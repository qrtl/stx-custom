<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_chatgpt" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.chatgpt</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="40"/>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@id='allow_import']" position="before">
        <div class="col-12 col-lg-6 o_setting_box" id="openai_api_key_box">
          <div class="o_setting_right_pane">
            <label for="openai_api_key"/>
            <field name="openai_api_key" placeholder="Enter your OpenAI API Key here"/>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>